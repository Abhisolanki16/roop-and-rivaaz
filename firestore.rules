rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // ROOP & RIVAAZ - PRODUCTION FIRESTORE RULES
    // ==========================================

    // 1. PRODUCTS COLLECTION
    // - Public: Anyone can read/view product catalogue
    // - Admin: Only authenticated admin can create, update, or delete products
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. CONFIG & STORE SETTINGS (settings, homeContent)
    // - Public: Anyone can read store settings & banner content
    // - Admin: Only authenticated admin can modify store config or UPI details
    match /config/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. ORDERS COLLECTION
    // - Customer: Any customer placing an order can create a new order document
    // - Privacy & Protection: ONLY authenticated admin can read (view/list), update status, or delete orders
    // - Prevents unauthorized visitors from scraping customer names, phone numbers, or addresses
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Default catch-all: Deny anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
