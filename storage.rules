rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ==========================================
    // ROOP & RIVAAZ - PRODUCTION STORAGE RULES
    // ==========================================

    // Product & Banner Images:
    // - Public: Anyone can view/download images
    // - Admin: Only authenticated admin can upload or delete files
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
